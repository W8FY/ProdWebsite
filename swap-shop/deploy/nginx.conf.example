# In the http {} block:
limit_req_zone $binary_remote_addr zone=swap_requests:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=swap_connections:10m;

# Inside the existing HTTPS server {} for the website:
location ^~ /swap-api/ {
    client_max_body_size 36m;
    client_body_timeout 30s;
    limit_req zone=swap_requests burst=30 nodelay;
    limit_req_status 429;
    limit_conn swap_connections 8;
    proxy_pass http://127.0.0.1:8787;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_cache off;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 45s;
    add_header Cache-Control "no-store, private, max-age=0" always;
    add_header X-Content-Type-Options nosniff always;
}
