# Copy to /etc/w8fy-swap/service.env, mode 600; fill values on the host only.
SWAP_DB=/var/lib/w8fy-swap/shop.sqlite
SWAP_ORIGIN=https://w8fy.org
SWAP_ADMINS=replace-with-administrator-email
SWAP_TRUST_PROXY=true
PORT=8787
SMTP_HOST=replace-with-provider-host
SMTP_PORT=587
SMTP_USER=replace-on-host
SMTP_PASS=replace-on-host
SMTP_FROM=replace-with-verified-sender-email
